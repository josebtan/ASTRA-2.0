<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado "seleccionado": timelapse en curso, círculo interior rojo -->
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke
                        android:width="4dp"
                        android:color="@color/astra_white" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item
                android:top="8dp"
                android:bottom="8dp"
                android:left="8dp"
                android:right="8dp">
                <shape android:shape="oval">
                    <solid android:color="@color/astra_recording" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Estado normal -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke
                        android:width="4dp"
                        android:color="@color/astra_white" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item
                android:top="8dp"
                android:bottom="8dp"
                android:left="8dp"
                android:right="8dp">
                <shape android:shape="oval">
                    <solid android:color="@color/astra_white" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
