<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">

    <com.astra.camera.SquareImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:background="@color/astra_surface"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/ivPlayOverlay"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_play_overlay"
        android:visibility="gone"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tvRawBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="4dp"
        android:background="@drawable/bg_raw_badge"
        android:paddingHorizontal="5dp"
        android:paddingVertical="2dp"
        android:text="RAW"
        android:textColor="@color/astra_white"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
