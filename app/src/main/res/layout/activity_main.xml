<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/astra_black">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Degradados sutiles para que los controles se lean bien sobre cualquier escena -->
    <View
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="@drawable/gradient_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:background="@drawable/gradient_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cuenta regresiva del temporizador -->
    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/astra_white"
        android:textSize="96sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-light"
        android:shadowColor="#80000000"
        android:shadowRadius="12"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="3"
        tools:visibility="visible" />

    <!-- Barra superior: flash y temporizador, con icono + etiqueta para que su estado sea siempre claro -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Chip de flash: icono + etiqueta de texto (OFF / ON / AUTO) -->
        <LinearLayout
            android:id="@+id/btnFlash"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_chip_button"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="14dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/content_description_flash">

            <ImageView
                android:id="@+id/ivFlashIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_flash_off"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvFlashLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/timer_off"
                android:textColor="@color/astra_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Chip de temporizador: icono de reloj + etiqueta de tiempo (OFF / 3s / 10s) -->
        <LinearLayout
            android:id="@+id/btnTimer"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_chip_button"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="14dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/content_description_timer">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_timer"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvTimerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/timer_off"
                android:textColor="@color/astra_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Chip del menú de modos colapsable: Manual / Timelapse / Astrofotografía -->
        <LinearLayout
            android:id="@+id/btnModes"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_chip_button"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="14dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/content_description_modes">

            <ImageView
                android:id="@+id/ivModesIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_modes"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvModesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/mode_normal_label"
                android:textColor="@color/astra_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

    </LinearLayout>

    <!-- Panel colapsable de modos: se muestra/oculta al pulsar el chip "Modos".
         Cada modo es una sección de acordeón con su propio submenú de parámetros. -->
    <ScrollView
        android:id="@+id/scrollModesPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="380dp"
        app:layout_constraintVertical_bias="1"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/panelModes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_modes_panel"
            android:padding="16dp">

            <!-- ===== Manual ===== -->
            <LinearLayout
                android:id="@+id/headerManual"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_manual"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/mode_manual_name"
                    android:textColor="@color/astra_white"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivChevronManual"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_down"
                    android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contentManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingStart="32dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                tools:visibility="visible">

                <!-- ISO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/manual_iso_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvIsoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_label"
                        android:textColor="@color/astra_accent"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekIso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="@color/astra_accent"
                    android:thumbTint="@color/astra_accent" />

                <!-- Exposición -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/manual_exposure_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvExposureValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textColor="@color/astra_accent"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekExposure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="@color/astra_accent"
                    android:thumbTint="@color/astra_accent" />

                <!-- Contraste -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/manual_contrast_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvContrastValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/astra_accent"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekContrast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="@color/astra_accent"
                    android:thumbTint="@color/astra_accent" />

                <!-- RAW -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/manual_raw_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchRaw"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/manual_note"
                    android:textColor="@color/astra_gray"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnResetManual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:text="@string/manual_reset"
                    android:textColor="@color/astra_accent"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:padding="8dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/astra_divider" />

            <!-- ===== Timelapse ===== -->
            <LinearLayout
                android:id="@+id/headerTimelapse"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_timelapse"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/mode_timelapse_name"
                    android:textColor="@color/astra_white"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivChevronTimelapse"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_down"
                    android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contentTimelapse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingStart="32dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                tools:visibility="visible">

                <!-- Intervalo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/timelapse_interval_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTimelapseInterval"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5s"
                        android:textColor="@color/astra_accent"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekTimelapseInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="119"
                    android:progress="4"
                    android:progressTint="@color/astra_accent"
                    android:thumbTint="@color/astra_accent" />

                <!-- Número de fotos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/timelapse_shots_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTimelapseShots"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/timelapse_shots_infinite"
                        android:textColor="@color/astra_accent"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekTimelapseShots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="200"
                    android:progress="0"
                    android:progressTint="@color/astra_accent"
                    android:thumbTint="@color/astra_accent" />

                <!-- Velocidad (FPS) del video final -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/timelapse_fps_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTimelapseFps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 fps"
                        android:textColor="@color/astra_accent"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekTimelapseFps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="28"
                    android:progress="8"
                    android:progressTint="@color/astra_accent"
                    android:thumbTint="@color/astra_accent" />

                <TextView
                    android:id="@+id/tvTimelapseStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/timelapse_status_idle"
                    android:textColor="@color/astra_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/timelapse_note"
                    android:textColor="@color/astra_gray"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/astra_divider" />

            <!-- ===== Astrofotografía ===== -->
            <LinearLayout
                android:id="@+id/headerAstro"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_astro"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/mode_astro_name"
                    android:textColor="@color/astra_white"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/ivChevronAstro"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_down"
                    android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contentAstro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingStart="32dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                tools:visibility="visible">

                <!-- ISO astro -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/astro_iso_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvAstroIso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_label"
                        android:textColor="@color/astra_accent"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekAstroIso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="@color/astra_accent"
                    android:thumbTint="@color/astra_accent" />

                <!-- Tiempo de exposición astro -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/astro_exposure_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvAstroExposure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_label"
                        android:textColor="@color/astra_accent"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekAstroExposure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="@color/astra_accent"
                    android:thumbTint="@color/astra_accent" />

                <!-- Reducción de ruido -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/astro_noise_reduction_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAstroNoiseReduction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/astro_note"
                    android:textColor="@color/astra_gray"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Barra inferior: galería, captura y cambio de cámara -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp"
        android:paddingBottom="36dp"
        android:paddingTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_gallery_thumbnail"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_gallery_placeholder"
            android:padding="10dp"
            android:contentDescription="@string/content_description_gallery"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_capture_button"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_description_capture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Anillo de progreso de exposición larga (Astro): mismo centro que
             btnCapture pero más grande, así queda "alrededor" del botón. Al
             ser un indicador circular (solo el trazo, sin relleno), no tapa
             el ícono de captura. -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressCapture"
            android:layout_width="94dp"
            android:layout_height="94dp"
            android:visibility="gone"
            app:indicatorColor="@color/astra_accent"
            app:trackColor="#33FFFFFF"
            app:trackThickness="3dp"
            app:layout_constraintStart_toStartOf="@id/btnCapture"
            app:layout_constraintEnd_toEndOf="@id/btnCapture"
            app:layout_constraintTop_toTopOf="@id/btnCapture"
            app:layout_constraintBottom_toBottomOf="@id/btnCapture"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_round_button"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:src="@drawable/ic_switch_camera"
            android:contentDescription="@string/content_description_switch_camera"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Contador de tiempo restante durante una captura de exposición larga
         (Astro). Flota justo encima del botón de captura, que ahora muestra
         el anillo de progreso a su alrededor. -->
    <LinearLayout
        android:id="@+id/captureCountdownPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chip_button"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvCaptureCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/astra_white"
            android:textStyle="bold"
            android:textSize="14sp"
            tools:text="4.0 s" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/capture_long_exposure_label"
            android:textColor="@color/astra_gray"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Info en vivo del timelapse (fotos tomadas + duración estimada del
         video final): flota sobre la previsualización mientras se captura,
         no dentro del menú de configuración. -->
    <LinearLayout
        android:id="@+id/timelapseInfoPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chip_button"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp"
        tools:visibility="visible">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_recording_dot" />

        <TextView
            android:id="@+id/tvTimelapseInfoShots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/astra_white"
            android:textStyle="bold"
            android:textSize="13sp"
            tools:text="Foto 12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="·"
            android:textColor="@color/astra_gray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTimelapseInfoDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/astra_accent"
            android:textStyle="bold"
            android:textSize="13sp"
            tools:text="Video: 1.2 s" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
