<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/astra_black">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Degradados sutiles para que los controles se lean bien sobre cualquier escena -->
    <View
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="@drawable/gradient_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:background="@drawable/gradient_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cuenta regresiva del temporizador -->
    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/astra_white"
        android:textSize="96sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-light"
        android:shadowColor="#80000000"
        android:shadowRadius="12"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="3"
        tools:visibility="visible" />

    <!-- Barra superior: flash y temporizador, con icono + etiqueta para que su estado sea siempre claro -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Chip de flash: icono + etiqueta de texto (OFF / ON / AUTO) -->
        <LinearLayout
            android:id="@+id/btnFlash"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_chip_button"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="14dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/content_description_flash">

            <ImageView
                android:id="@+id/ivFlashIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_flash_off"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvFlashLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/timer_off"
                android:textColor="@color/astra_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Chip de temporizador: icono de reloj + etiqueta de tiempo (OFF / 3s / 10s) -->
        <LinearLayout
            android:id="@+id/btnTimer"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_chip_button"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="14dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/content_description_timer">

            <ImageView
                android:id="@+id/ivTimerIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_timer"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvTimerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/timer_off"
                android:textColor="@color/astra_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Submenú de parámetros del modo activo. Se despliega hacia arriba desde
         la barra de pestañas de modos (justo debajo) y se oculta hacia abajo
         al cerrarlo; solo se muestra el contenido del modo seleccionado.

         Diseño pensado desde el inicio para la rotación: cada VALOR (ISO,
         exposición, intervalo, etc.) vive en un badge CUADRADO de tamaño
         FIJO (40dp x 40dp). Un cuadrado rotado 90° sigue siendo el mismo
         cuadrado — no cambia su ancho ni su alto — así que rotarlo con
         View.animate().rotation() (la misma técnica simple que ya funciona
         en los iconos) no recorta ni solapa nada, sin necesidad de ningún
         ViewGroup personalizado ni medición dinámica. Las etiquetas y los
         SeekBar se quedan siempre horizontales (igual que en cualquier app
         de cámara real: solo lo mínimo necesario para leer el valor rota). -->
    <ScrollView
        android:id="@+id/scrollModesPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="360dp"
        app:layout_constraintVertical_bias="1"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/panelModes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_modes_panel"
            android:padding="16dp">

            <!-- ===== Manual: ISO, exposición, contraste, RAW ===== -->
            <LinearLayout
                android:id="@+id/contentManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- ISO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/manual_iso_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvIsoValue"
                        style="@style/ValueBadge"
                        android:text="@string/auto_label" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekIso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:progressTint="@color/astra_accent"
                    android:thumbTint="@color/astra_accent" />

                <!-- Exposición -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/manual_exposure_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvExposureValue"
                        style="@style/ValueBadge"
                        android:text="0.0" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekExposure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:progressTint="@color/astra_accent"
                    android:thumbTint="@color/astra_accent" />

                <!-- Contraste -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/manual_contrast_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvContrastValue"
                        style="@style/ValueBadge"
                        android:text="0" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekContrast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="@color/astra_accent"
                    android:thumbTint="@color/astra_accent" />

                <!-- RAW -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/manual_raw_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchRaw"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/manual_note"
                    android:textColor="@color/astra_gray"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnResetManual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:text="@string/manual_reset"
                    android:textColor="@color/astra_accent"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:padding="8dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ===== Timelapse: intervalo, número de fotos, iniciar/detener ===== -->
            <LinearLayout
                android:id="@+id/contentTimelapse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Intervalo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/timelapse_interval_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTimelapseInterval"
                        style="@style/ValueBadge"
                        android:text="5s" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekTimelapseInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="119"
                    android:progress="4"
                    android:progressTint="@color/astra_accent"
                    android:thumbTint="@color/astra_accent" />

                <!-- Número de fotos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/timelapse_shots_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTimelapseShots"
                        style="@style/ValueBadge"
                        android:text="@string/timelapse_shots_infinite" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekTimelapseShots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="200"
                    android:progress="0"
                    android:progressTint="@color/astra_accent"
                    android:thumbTint="@color/astra_accent" />

                <!-- Velocidad (FPS) del video final -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/timelapse_fps_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTimelapseFps"
                        style="@style/ValueBadge"
                        android:text="10 fps" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekTimelapseFps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="28"
                    android:progress="8"
                    android:progressTint="@color/astra_accent"
                    android:thumbTint="@color/astra_accent" />

                <TextView
                    android:id="@+id/tvTimelapseStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/timelapse_status_idle"
                    android:textColor="@color/astra_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/timelapse_note"
                    android:textColor="@color/astra_gray"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- ===== Astrofotografía: ISO alto + exposición larga ===== -->
            <LinearLayout
                android:id="@+id/contentAstro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- ISO astro -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/astro_iso_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvAstroIso"
                        style="@style/ValueBadge"
                        android:text="@string/auto_label" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekAstroIso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:progressTint="@color/astra_accent"
                    android:thumbTint="@color/astra_accent" />

                <!-- Tiempo de exposición astro -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/astro_exposure_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvAstroExposure"
                        style="@style/ValueBadge"
                        android:text="@string/auto_label" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekAstroExposure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:progressTint="@color/astra_accent"
                    android:thumbTint="@color/astra_accent" />

                <!-- Reducción de ruido -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/astro_noise_reduction_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAstroNoiseReduction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/astro_note"
                    android:textColor="@color/astra_gray"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/astra_divider" />

                <!-- ===== Apilado de imágenes (Stacking) ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/astro_stacking_label"
                        android:textColor="@color/astra_white"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAstroStacking"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/groupAstroStackingOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/astro_stacking_shots_label"
                            android:textColor="@color/astra_white"
                            android:textStyle="bold"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvAstroStackShots"
                            style="@style/ValueBadge"
                            android:text="10" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekAstroStackShots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:max="48"
                        android:progress="8"
                        android:progressTint="@color/astra_accent"
                        android:thumbTint="@color/astra_accent" />

                    <!-- Alineación de estrellas: corrige pequeños movimientos
                         de la cámara o la rotación terrestre entre fotogramas
                         antes de promediarlos, para que las estrellas queden
                         como puntos nítidos y no como rayas. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/astro_align_stars_label"
                            android:textColor="@color/astra_white"
                            android:textStyle="bold"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAstroAlignStars"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/astro_align_stars_note"
                        android:textColor="@color/astra_gray"
                        android:textSize="11sp" />

                    <!-- Contraste fondo/estrellas: estira el punto negro de la
                         imagen apilada final para oscurecer el fondo del
                         cielo y que las estrellas resalten más frente a él. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/astro_boost_contrast_label"
                            android:textColor="@color/astra_white"
                            android:textStyle="bold"
                            android:textSize="13sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAstroBoostContrast"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/astro_boost_contrast_note"
                        android:textColor="@color/astra_gray"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvAstroStackStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/astro_stacking_status_idle"
                        android:textColor="@color/astra_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/astro_stacking_note"
                        android:textColor="@color/astra_gray"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>


    <!-- Barra inferior: galería, captura y cambio de cámara -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp"
        android:paddingBottom="16dp"
        android:paddingTop="16dp"
        app:layout_constraintBottom_toTopOf="@id/modesTabBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_gallery_thumbnail"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_gallery_placeholder"
            android:padding="10dp"
            android:contentDescription="@string/content_description_gallery"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_capture_button"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_description_capture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Anillo de progreso de exposición larga (Astro): mismo centro que
             btnCapture pero más grande, así queda "alrededor" del botón. Al
             ser un indicador circular (solo el trazo, sin relleno), no tapa
             el ícono de captura. -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressCapture"
            android:layout_width="94dp"
            android:layout_height="94dp"
            android:visibility="gone"
            app:indicatorColor="@color/astra_accent"
            app:trackColor="#33FFFFFF"
            app:trackThickness="3dp"
            app:layout_constraintStart_toStartOf="@id/btnCapture"
            app:layout_constraintEnd_toEndOf="@id/btnCapture"
            app:layout_constraintTop_toTopOf="@id/btnCapture"
            app:layout_constraintBottom_toBottomOf="@id/btnCapture"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_round_button"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:src="@drawable/ic_switch_camera"
            android:contentDescription="@string/content_description_switch_camera"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Barra de pestañas de modos: horizontal, debajo del botón de captura.
         Cada pestaña alterna su propio submenú de parámetros, que se
         despliega hacia arriba desde aquí (ver scrollModesPanel) y se
         repliega hacia abajo al volver a tocar la pestaña activa o "Normal". -->
    <LinearLayout
        android:id="@+id/modesTabBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/astra_panel_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/tabNormal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/indicatorNormal"
                android:layout_width="24dp"
                android:layout_height="2dp"
                android:background="@color/astra_accent"
                android:visibility="invisible" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="5dp"
                android:id="@+id/ivTabNormalIcon"
                android:src="@drawable/ic_auto_mode"
                app:tint="@color/tab_icon_color"
                android:duplicateParentState="true"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mode_normal_label"
                android:textColor="@color/tab_icon_color"
                android:textSize="10sp"
                android:textStyle="bold"
                android:duplicateParentState="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabManual"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/indicatorManual"
                android:layout_width="24dp"
                android:layout_height="2dp"
                android:background="@color/astra_accent"
                android:visibility="invisible" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="5dp"
                android:id="@+id/ivTabManualIcon"
                android:src="@drawable/ic_manual"
                app:tint="@color/tab_icon_color"
                android:duplicateParentState="true"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mode_manual_name"
                android:textColor="@color/tab_icon_color"
                android:textSize="10sp"
                android:textStyle="bold"
                android:duplicateParentState="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabTimelapse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/indicatorTimelapse"
                android:layout_width="24dp"
                android:layout_height="2dp"
                android:background="@color/astra_accent"
                android:visibility="invisible" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="5dp"
                android:id="@+id/ivTabTimelapseIcon"
                android:src="@drawable/ic_timelapse"
                app:tint="@color/tab_icon_color"
                android:duplicateParentState="true"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mode_timelapse_name"
                android:textColor="@color/tab_icon_color"
                android:textSize="10sp"
                android:textStyle="bold"
                android:duplicateParentState="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabAstro"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/indicatorAstro"
                android:layout_width="24dp"
                android:layout_height="2dp"
                android:background="@color/astra_accent"
                android:visibility="invisible" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="5dp"
                android:id="@+id/ivTabAstroIcon"
                android:src="@drawable/ic_astro"
                app:tint="@color/tab_icon_color"
                android:duplicateParentState="true"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mode_astro_name"
                android:textColor="@color/tab_icon_color"
                android:textSize="10sp"
                android:textStyle="bold"
                android:duplicateParentState="true" />
        </LinearLayout>

    </LinearLayout>

    <!-- Contador de tiempo restante durante una captura de exposición larga
         (Astro). Flota justo encima del botón de captura, que ahora muestra
         el anillo de progreso a su alrededor. -->
    <LinearLayout
        android:id="@+id/captureCountdownPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chip_button"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvCaptureCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/astra_white"
            android:textStyle="bold"
            android:textSize="14sp"
            tools:text="4.0 s" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/capture_long_exposure_label"
            android:textColor="@color/astra_gray"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Info en vivo del timelapse (fotos tomadas + duración estimada del
         video final): flota sobre la previsualización mientras se captura,
         no dentro del menú de configuración. -->
    <LinearLayout
        android:id="@+id/timelapseInfoPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chip_button"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        tools:visibility="visible">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_recording_dot" />

        <TextView
            android:id="@+id/tvTimelapseInfoShots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/astra_white"
            android:textStyle="bold"
            android:textSize="13sp"
            tools:text="Foto 12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="·"
            android:textColor="@color/astra_gray"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTimelapseInfoDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/astra_accent"
            android:textStyle="bold"
            android:textSize="13sp"
            tools:text="Video: 1.2 s" />

    </LinearLayout>

    <!-- Info en vivo del apilado (stacking) de Astro: cuántas fotos van de
         cuántas en total. Flota sobre la previsualización mientras se
         captura, no dentro del menú de configuración. -->
    <LinearLayout
        android:id="@+id/astroStackInfoPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chip_button"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        tools:visibility="visible">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_recording_dot" />

        <TextView
            android:id="@+id/tvAstroStackInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/astra_white"
            android:textStyle="bold"
            android:textSize="13sp"
            tools:text="Apilando: foto 4 / 10" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
